# ---------------------------------------------------------------------------
# Membership tool configuration (see docs/membership.md)
#
# Everything below is OPTIONAL. With no payment variables set, only the
# development "mock" rail is available and no real payment can be taken.
# Copy this file to `.env` (gitignored) and edit.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Identity --------------------------------------------------------------
# Link used by /internal/login to start the DFRI-eID certificate flow.
# DFRI_EID_LOGIN_URL=https://localhost:8443/internal

# Certificate subjects allowed to manage members/payments.
# Comma-separated. Empty means "nobody", which is intentional.
# MEMBERSHIP_ADMIN_SUBJECTS=test-person-001

# --- Ledger ----------------------------------------------------------------
# Ledger file for the local JSON store (default: .data/membership.json).
# MEMBERSHIP_DATA_FILE=.data/membership.json

# Seed the development plans (default: true outside production).
# Never seed prices in production until the board has approved them.
# MEMBERSHIP_SEED_PLANS=true

# Enable mock payments and the /api/membership/dev/* test endpoints.
# Default: true outside production. NEVER enable in production.
# MEMBERSHIP_ENABLE_DEV_TOOLS=true

# Provisional renewal behaviour: stack a new purchase after the current one.
# MEMBERSHIP_RENEWAL_STACKS=true

# Unit symbol used by the draft plans (default: HOT).
# MEMBERSHIP_CURRENCY=HOT

# --- HOT / EVM rail --------------------------------------------------------
# HOT is an ERC-20 token. Point these at the token you actually accept.
# For a testnet run, deploy a test ERC-20 and use its address; the real HOT
# mainnet contract is not a test asset.
# HOT_EVM_RPC_URL=https://rpc.sepolia.org
# HOT_EVM_CHAIN_ID=11155111
# HOT_EVM_TOKEN_ADDRESS=0xYourTestTokenAddress
# HOT_EVM_TOKEN_DECIMALS=18
# HOT_EVM_TREASURY_ADDRESS=0xYourTreasuryAddress
# HOT_EVM_MIN_CONFIRMATIONS=3
# HOT_EVM_NETWORK_NAME=Ethereum Sepolia
# HOT_EVM_EXPLORER_URL=https://sepolia.etherscan.io
# HOT_EVM_CURRENCY_SYMBOL=HOT
